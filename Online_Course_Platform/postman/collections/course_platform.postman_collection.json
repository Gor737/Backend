{
  "info": {
    "_postman_id": "3e0b3c4a-7e22-4ed2-9e3d-0f2d5f1e4c01",
    "name": "Online Course Platform",
    "description": "Postman collection for the Online Course Platform REST API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminToken", "value": "" },
    { "key": "instructorToken", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "userId", "value": "7" },
    { "key": "courseId", "value": "5" },
    { "key": "lessonId", "value": "1" },
    { "key": "enrollmentId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"New Student\",\n  \"email\": \"newstudent@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student03@gmail.com\",\n  \"password\": \"YOUR_PASSWORD\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"YOUR_REFRESH_TOKEN\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/refresh"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Get Users - Filter by Role",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/users?role=student"
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Update User Role",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"instructor\"\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}/role"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Get Published Courses",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/courses"
          }
        },
        {
          "name": "Get Courses - Filter",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/courses?category=Web%20Development&level=beginner"
          }
        },
        {
          "name": "Get My Courses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{instructorToken}}" }],
            "url": "{{baseUrl}}/api/courses/my"
          }
        },
        {
          "name": "Get Course by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/api/courses/{{courseId}}"
          }
        },
        {
          "name": "Create Course",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Advanced JavaScript\",\n  \"description\": \"Deep dive into modern JavaScript concepts\",\n  \"category\": \"Web Development\",\n  \"level\": \"advanced\",\n  \"price\": 7000,\n  \"isPublished\": false\n}"
            },
            "url": "{{baseUrl}}/api/courses"
          }
        },
        {
          "name": "Update Course",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"JavaScript Fundamentals Updated\",\n  \"description\": \"Updated JavaScript fundamentals course\",\n  \"category\": \"Web Development\",\n  \"level\": \"beginner\",\n  \"price\": 5000,\n  \"isPublished\": true\n}"
            },
            "url": "{{baseUrl}}/api/courses/{{courseId}}"
          }
        },
        {
          "name": "Delete Course",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{instructorToken}}" }],
            "url": "{{baseUrl}}/api/courses/{{courseId}}"
          }
        },
        {
          "name": "Get Course Students",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{instructorToken}}" }],
            "url": "{{baseUrl}}/api/courses/{{courseId}}/students"
          }
        }
      ]
    },
    {
      "name": "Lessons",
      "item": [
        {
          "name": "Get Course Lessons",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/api/courses/{{courseId}}/lessons"
          }
        },
        {
          "name": "Get Lesson by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/api/lessons/{{lessonId}}"
          }
        },
        {
          "name": "Create Lesson",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Objects in JavaScript\",\n  \"content\": \"Learn objects, properties, and methods\",\n  \"duration\": 35,\n  \"order\": 4\n}"
            },
            "url": "{{baseUrl}}/api/courses/{{courseId}}/lessons"
          }
        },
        {
          "name": "Update Lesson",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Objects in JavaScript Updated\",\n  \"content\": \"Updated lesson content\",\n  \"duration\": 40,\n  \"order\": 4\n}"
            },
            "url": "{{baseUrl}}/api/lessons/{{lessonId}}"
          }
        },
        {
          "name": "Delete Lesson",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{instructorToken}}" }],
            "url": "{{baseUrl}}/api/lessons/{{lessonId}}"
          }
        }
      ]
    },
    {
      "name": "Enrollments",
      "item": [
        {
          "name": "Create Enrollment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": {{courseId}}\n}"
            },
            "url": "{{baseUrl}}/api/enrollments"
          }
        },
        {
          "name": "Get My Enrollments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/api/enrollments/me"
          }
        },
        {
          "name": "Update Enrollment Progress",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"progress\": 50\n}"
            },
            "url": "{{baseUrl}}/api/enrollments/{{enrollmentId}}/progress"
          }
        },
        {
          "name": "Cancel Enrollment",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/api/enrollments/{{enrollmentId}}"
          }
        },
        {
          "name": "Get All Enrollments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/enrollments"
          }
        }
      ]
    }
  ]
}
